# ── Development environment ───────────────────────────────────────────────────
# Copy this file to .env and adjust values for your local setup.
# In production, DATABASE_URL is set programmatically by the Electron main process.

# SQLite database path (relative to prisma/ directory, used by Prisma CLI in dev)
DATABASE_URL="file:../database/pos.db"

# Environment
NODE_ENV=development
